# Sao chép file này thành `.env` và điền thông tin thành viên của bạn
DISCORD_BOT_TOKEN=PASTE_SHARED_OR_PERSONAL_BOT_TOKEN_HERE
DISCORD_CHANNEL_ID=1572101960855724055
DISCORD_WEBHOOK_URL=

# Đổi tên & vai trò đúng với máy của bạn (khớp với team_roster.json)
AI_AGENT_NAME=AI-Minh
AI_AGENT_ROLE=Nghiên cứu, viết kịch bản, tối ưu hook và tiêu đề

# CHỈ 1 máy chính trong team đặt IS_ROUTER=true; các máy khác để false
IS_ROUTER=false
USE_GEMINI_DECISION=false
DECISION_THRESHOLD=0.70
ENABLE_WINDOWS_TOAST=true
MAX_AI_HOPS=3
DISCORD_APP_ID=1572813558050193418
