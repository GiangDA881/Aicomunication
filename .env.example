# Copy to .env. Never commit .env.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AGENTHUB_CREDENTIAL_KEY=
POSTGRES_PASSWORD=change-me

# Public URL of the API (used for the OAuth redirect)
AGENTHUB_PUBLIC_BASE_URL=http://localhost:8000

# Discord application (https://discord.com/developers/applications)
AGENTHUB_DISCORD_BOT_TOKEN=
AGENTHUB_DISCORD_CLIENT_ID=
AGENTHUB_DISCORD_CLIENT_SECRET=
# Optional: sync slash commands to one guild instantly (otherwise global sync, can take up to 1h)
AGENTHUB_DISCORD_GUILD_ID=
# Optional fallback channel for event projection when a project has no bound channel
AGENTHUB_DISCORD_PROJECTION_CHANNEL_ID=

# GitHub webhook secret (repo Settings > Webhooks, content type application/json)
AGENTHUB_GITHUB_WEBHOOK_SECRET=

# Limits
AGENTHUB_MAX_AGENTS_PER_USER=10
AGENTHUB_PROVIDER_TIMEOUT_SECONDS=60
AGENTHUB_MAX_EVENT_HOPS=6
AGENTHUB_DEFAULT_AGENT_BUDGET_TOKENS=200000
AGENTHUB_DEFAULT_AGENT_BUDGET_USD=5.0
